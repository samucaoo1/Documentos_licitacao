{
  "manifest_version": 3,
  "name": "Documentos de Licitação",
  "version": "0.5.0",
  "description": "Central local para emitir e baixar certidões de licitantes nos portais oficiais.",
  "permissions": [
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://certidoes.cgu.gov.br/*",
    "https://cndt-certidao.tst.jus.br/*",
    "https://solucoes.receita.fazenda.gov.br/*",
    "https://servicos.receitafederal.gov.br/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://certidoes.cgu.gov.br/*"],
      "js": ["content/common.js", "content/cgu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cndt-certidao.tst.jus.br/*"],
      "js": ["content/common.js", "content/cndt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://solucoes.receita.fazenda.gov.br/Servicos/cnpjreva/*"],
      "js": ["content/common.js", "content/cnpj.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://servicos.receitafederal.gov.br/servico/certidoes/*"],
      "js": ["content/common.js", "content/federal.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Documentos de Licitação",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "documentos-licitacao@samucaoo1.github.io",
      "strict_min_version": "121.0"
    }
  }
}
